{
  "name": "direct-qr",
  "private": true,
  "version": "1.0.0",
  "description": "Client-side static QR generator & validator that never uses intermediate redirect domains.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.510.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.0"
  }
}
